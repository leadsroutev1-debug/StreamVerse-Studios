modules = ["nodejs-24", "python-3.11"]

[deployment]
deploymentTarget = "autoscale"
run = ["bash", "start.sh"]
build = ["bash", "-c", "python3 -m pip install --target .pythonlibs/lib/python3.11/site-packages --break-system-packages -r video_engine/requirements.txt"]

[nix]
channel = "stable-25_05"
packages = ["libxcrypt"]

[[ports]]
localPort = 5000
externalPort = 80
